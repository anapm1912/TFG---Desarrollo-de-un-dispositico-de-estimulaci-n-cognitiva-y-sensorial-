import { useRouter } from 'expo-router';
import { useEffect, useMemo, useState } from 'react';
import {
    Pressable,
    SafeAreaView,
    StyleSheet,
    Text,
    View,
} from 'react-native';


export default function GameScreen() {
  const router = useRouter();
  const [activity, setActivity] = useState(62);
  const [score, setScore] = useState(12);
  const [difficulty, setDifficulty] = useState(2);


  useEffect(() => {
    const interval = setInterval(() => {
      setActivity((prev) => {
        const change = Math.floor(Math.random() * 21) - 10;
        const next = Math.max(20, Math.min(100, prev + change));
        return next;
      });


      setScore((prev) => prev + 1);
    }, 1500);


    return () => clearInterval(interval);
  }, []);


  useEffect(() => {
    if (activity >= 75) {
      setDifficulty(3);
    } else if (activity >= 45) {
      setDifficulty(2);
    } else {
      setDifficulty(1);
    }
  }, [activity]);


  const difficultyLabel = useMemo(() => {
    if (difficulty === 1) return 'Baja';
    if (difficulty === 2) return 'Media';
    return 'Alta';
  }, [difficulty]);


  const targetSpeed = useMemo(() => {
    if (difficulty === 1) return 'Lenta';
    if (difficulty === 2) return 'Media';
    return 'Alta';
  }, [difficulty]);


  const helperText = useMemo(() => {
    if (difficulty === 1) {
      return 'El juego reduce la exigencia para evitar frustración o fatiga.';
    }
    if (difficulty === 2) {
      return 'El juego mantiene una exigencia equilibrada.';
    }
    return 'El juego aumenta el reto porque detecta buena actividad.';
  }, [difficulty]);


  return (
    <SafeAreaView style={styles.safe}>
      <View style={styles.container}>
        <View style={styles.topBar}>
          <View>
            <Text style={styles.eyebrow}>Juego adaptativo</Text>
            <Text style={styles.title}>Sesión activa</Text>
          </View>


          <Pressable style={styles.backButton} onPress={() => router.back()}>
            <Text style={styles.backButtonText}>Volver</Text>
          </Pressable>
        </View>


        <View style={styles.mainCard}>
          <Text style={styles.mainLabel}>Estado del juego</Text>
          <Text style={styles.mainValue}>Puntuación: {score}</Text>
          <Text style={styles.mainDescription}>
            Esta pantalla simula un minijuego terapéutico cuya dificultad cambia
            en función de la actividad detectada.
          </Text>
        </View>


        <View style={styles.grid}>
          <InfoCard title="Actividad detectada" value={`${activity}%`} />
          <InfoCard title="Dificultad" value={difficultyLabel} />
          <InfoCard title="Velocidad objetivo" value={targetSpeed} />
        </View>


        <View style={styles.feedbackCard}>
          <Text style={styles.feedbackTitle}>Adaptación automática</Text>
          <Text style={styles.feedbackText}>{helperText}</Text>
        </View>


        <View style={styles.playArea}>
          <Text style={styles.playAreaTitle}>Área de juego</Text>
          <View style={styles.target}>
            <Text style={styles.targetText}>Objetivo</Text>
          </View>
          <Text style={styles.playHint}>
            Más adelante aquí podrás poner tu juego real conectado a los datos
            del Arduino o ESP32.
          </Text>
        </View>
      </View>
    </SafeAreaView>
  );
}


function InfoCard({ title, value }: { title: string; value: string }) {
  return (
    <View style={styles.infoCard}>
      <Text style={styles.infoTitle}>{title}</Text>
      <Text style={styles.infoValue}>{value}</Text>
    </View>
  );
}


