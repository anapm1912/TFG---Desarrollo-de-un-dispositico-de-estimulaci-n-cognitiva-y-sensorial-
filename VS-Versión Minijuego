import React, { useCallback, useEffect, useRef, useState } from 'react';
import { useRouter } from 'expo-router';
import {
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Text,
  View,
  Pressable,
} from 'react-native';

type DifficultyLevel = 1 | 2 | 3;
type SessionEvent = {
  id: number;
  timestamp: string;
  message: string;
  type: 'up' | 'down' | 'hold' | 'alert';
};

function getTimestamp() {
  const now = new Date();
  return `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
}

export default function AdaptiveScreen() {
  const router = useRouter();

  // --- Datos simulados del sensor (luego vendrán del Arduino/ESP32) ---
  const [activity, setActivity] = useState(68);
  const [attention, setAttention] = useState(74);
  const [responseTime, setResponseTime] = useState(1.8);
  const [movementQuality, setMovementQuality] = useState(71);

  // --- Estado del sistema adaptativo ---
  const [difficulty, setDifficulty] = useState<DifficultyLevel>(2);
  const [sessionEvents, setSessionEvents] = useState<SessionEvent[]>([]);
  const [sessionSeconds, setSessionSeconds] = useState(0);
  const [sessionActive, setSessionActive] = useState(true);

  const eventIdRef = useRef(0);
  const simulationRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const sessionTimerRef = useRef<ReturnType<typeof setInterval> | null>(null);

  // --- Añadir evento al registro de sesión ---
  const addEvent = useCallback(
    (message: string, type: SessionEvent['type']) => {
      eventIdRef.current += 1;
      setSessionEvents((prev) => [
        { id: eventIdRef.current, timestamp: getTimestamp(), message, type },
        ...prev.slice(0, 19),
      ]);
    },
    []
  );

  // --- Motor de IA adaptativa ---
  const computeDifficulty = useCallback(
    (
      act: number,
      att: number,
      rt: number,
      mq: number,
      current: DifficultyLevel
    ): { next: DifficultyLevel; reason: string } => {
      const score =
        act * 0.3 + att * 0.35 + (100 - rt * 20) * 0.2 + mq * 0.15;

      if (score >= 72) {
        return {
          next: 3,
          reason:
            'Actividad y atención elevadas. El sistema sube la dificultad para mantener el reto terapéutico.',
        };
      } else if (score >= 52) {
        return {
          next: 2,
          reason:
            'Rendimiento equilibrado. La dificultad se mantiene en nivel medio.',
        };
      } else {
        return {
          next: 1,
          reason:
            'Actividad o atención bajas. El sistema reduce la dificultad para evitar frustración.',
        };
      }
    },
    []
  );

  // --- Simulación de datos del sensor (reemplazar por BLE/serial luego) ---
  useEffect(() => {
    if (!sessionActive) return;

    simulationRef.current = setInterval(() => {
      setActivity((prev) => Math.max(20, Math.min(100, prev + Math.floor(Math.random() * 13) - 6)));
      setAttention((prev) => Math.max(20, Math.min(100, prev + Math.floor(Math.random() * 11) - 5)));
      setResponseTime((prev) => parseFloat(Math.max(0.5, Math.min(4.0, prev + (Math.random() * 0.4 - 0.2))).toFixed(1)));
      setMovementQuality((prev) => Math.max(20, Math.min(100, prev + Math.floor(Math.random() * 9) - 4)));
    }, 2000);

    return () => {
      if (simulationRef.current) clearInterval(simulationRef.current);
    };
  }, [sessionActive]);

  // --- Temporizador de sesión ---
  useEffect(() => {
    if (!sessionActive) return;

    sessionTimerRef.current = setInterval(() => {
      setSessionSeconds((prev) => prev + 1);
    }, 1000);

    return () => {
      if (sessionTimerRef.current) clearInterval(sessionTimerRef.current);
    };
  }, [sessionActive]);

  // --- Motor IA: recalcular dificultad cuando cambian métricas ---
  useEffect(() => {
    if (!sessionActive) return;

    const { next, reason } = computeDifficulty(
      activity,
      attention,
      responseTime,
      movementQuality,
      difficulty
    );

    if (next !== difficulty) {
      const prevLabel = diffLabel(difficulty);
      const nextLabel = diffLabel(next);
      const type = next > difficulty ? 'up' : 'down';

      setDifficulty(next);
      addEvent(
        `Dificultad: ${prevLabel} → ${nextLabel}. ${reason}`,
        type
      );
    }

    // Alertas automáticas
    if (attention < 35) {
      addEvent('Alerta: Atención muy baja. Considerar pausa.', 'alert');
    }
    if (activity < 30) {
      addEvent('Alerta: Actividad muy baja. Revisar sensor o estado.', 'alert');
    }
    if (responseTime > 3.2) {
      addEvent('Alerta: Tiempo de respuesta alto. Posible fatiga.', 'alert');
    }
  }, [activity, attention, responseTime, movementQuality]);

  // --- Control manual de dificultad ---
  const handleManualDifficulty = (level: DifficultyLevel) => {
    if (level !== difficulty) {
      addEvent(
        `Ajuste manual: dificultad cambiada a ${diffLabel(level)}.`,
        level > difficulty ? 'up' : 'down'
      );
      setDifficulty(level);
    }
  };

  const handleStopSession = () => {
    setSessionActive(false);
    if (simulationRef.current) clearInterval(simulationRef.current);
    if (sessionTimerRef.current) clearInterval(sessionTimerRef.current);
    addEvent('Sesión finalizada manualmente.', 'hold');
  };

  const formatSessionTime = () => {
    const m = Math.floor(sessionSeconds / 60).toString().padStart(2, '0');
    const s = (sessionSeconds % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  };

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.container}>
        {/* Cabecera */}
        <View style={styles.topBar}>
          <View>
            <Text style={styles.eyebrow}>Control adaptativo</Text>
            <Text style={styles.title}>Sesión en vivo</Text>
          </View>
          <Pressable style={styles.backButton} onPress={() => router.back()}>
            <Text style={styles.backButtonText}>Volver</Text>
          </Pressable>
        </View>

        {/* Estado general */}
        <View style={styles.statusRow}>
          <View style={[styles.statusBadge, sessionActive ? styles.badgeActive : styles.badgeInactive]}>
            <Text style={styles.statusBadgeText}>
              {sessionActive ? '● Sesión activa' : '■ Sesión detenida'}
            </Text>
          </View>
          <Text style={styles.sessionTime}>{formatSessionTime()}</Text>
        </View>

        {/* Métricas en tiempo real */}
        <SectionTitle
          title="Métricas en tiempo real"
          subtitle="Datos del sensor. Estos valores guiarán la IA para ajustar la dificultad."
        />
        <View style={styles.grid}>
          <MetricCard title="Actividad" value={`${activity}%`} alert={activity < 35} />
          <MetricCard title="Atención" value={`${attention}%`} alert={attention < 35} />
          <MetricCard title="T. Respuesta" value={`${responseTime}s`} alert={responseTime > 3.2} />
          <MetricCard title="Mov. Calidad" value={`${movementQuality}%`} alert={movementQuality < 30} />
        </View>

        {/* Nivel de dificultad actual */}
        <SectionTitle
          title="Dificultad actual"
          subtitle="Calculada automáticamente por la IA. También puedes ajustarla de forma manual."
        />
        <View style={styles.diffCard}>
          <View style={styles.diffLabelRow}>
            <Text style={styles.diffValue}>{diffLabel(difficulty)}</Text>
            <View style={[styles.diffBadge, diffColor(difficulty)]}>
              <Text style={styles.diffBadgeText}>Nivel {difficulty}/3</Text>
            </View>
          </View>
          <Text style={styles.diffHint}>
            {difficulty === 1
              ? 'El juego terapéutico recibirá parámetros de baja exigencia.'
              : difficulty === 2
              ? 'El juego terapéutico recibirá parámetros de exigencia media.'
              : 'El juego terapéutico recibirá parámetros de alta exigencia.'}
          </Text>

          <View style={styles.manualButtons}>
            {([1, 2, 3] as DifficultyLevel[]).map((level) => (
              <Pressable
                key={level}
                style={[
                  styles.manualBtn,
                  level === difficulty && styles.manualBtnActive,
                ]}
                onPress={() => handleManualDifficulty(level)}
              >
                <Text
                  style={[
                    styles.manualBtnText,
                    level === difficulty && styles.manualBtnTextActive,
                  ]}
                >
                  {diffLabel(level)}
                </Text>
              </Pressable>
            ))}
          </View>
        </View>

        {/* Control de sesión */}
        {sessionActive && (
          <Pressable style={styles.stopButton} onPress={handleStopSession}>
            <Text style={styles.stopButtonText}>Detener sesión</Text>
          </Pressable>
        )}

        {/* Registro de eventos */}
        <SectionTitle
          title="Registro de sesión"
          subtitle="Historial automático de cambios y alertas detectadas por la IA."
        />

        {sessionEvents.length === 0 ? (
          <View style={styles.emptyState}>
            <Text style={styles.emptyStateText}>
              Aún no hay eventos registrados. Los cambios de dificultad y alertas aparecerán aquí.
            </Text>
          </View>
        ) : (
          <View style={styles.eventList}>
            {sessionEvents.map((event) => (
              <View
                key={event.id}
                style={[
                  styles.eventItem,
                  event.type === 'up' && styles.eventUp,
                  event.type === 'down' && styles.eventDown,
                  event.type === 'alert' && styles.eventAlert,
                  event.type === 'hold' && styles.eventHold,
                ]}
              >
                <Text style={styles.eventTime}>{event.timestamp}</Text>
                <Text style={styles.eventMessage}>{event.message}</Text>
              </View>
            ))}
          </View>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

function diffLabel(level: DifficultyLevel): string {
  if (level === 1) return 'Baja';
  if (level === 2) return 'Media';
  return 'Alta';
}

function diffColor(level: DifficultyLevel) {
  if (level === 1) return { backgroundColor: '#d4dfcc' };
  if (level === 2) return { backgroundColor: '#e9e0c6' };
  return { backgroundColor: '#cedcd8' };
}

function SectionTitle({ title, subtitle }: { title: string; subtitle: string }) {
  return (
    <View style={styles.sectionHeader}>
      <Text style={styles.sectionTitle}>{title}</Text>
      <Text style={styles.sectionSubtitle}>{subtitle}</Text>
    </View>
  );
}

function MetricCard({
  title,
  value,
  alert,
}: {
  title: string;
  value: string;
  alert?: boolean;
}) {
  return (
    <View style={[styles.metricCard, alert && styles.metricCardAlert]}>
      <Text style={styles.metricTitle}>{title}</Text>
      <Text style={[styles.metricValue, alert && styles.metricValueAlert]}>
        {value}
      </Text>
    </View>
  );
}

